dualnet_al/prep_hf.py

# Large derived artifact: rebuild with dualnet_al/make_bundle.sh
deliverables/DualNet-AL_Demo_Bundle.zip

# Editor / agent working state
.cocreate/
.DS_Store
*.tmp

# LaTeX build by-products
paper_arxiv/*.log
paper_arxiv/*.aux
paper_arxiv/*.out
